# BIT — Environment configuration example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# The default paper blend does not read these keys and cannot place orders.
# Leave them blank.

# ── Bybit credentials (unused by the paper blend) ────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ── Trading mode ──────────────────────────────────────────────────────────────
# blend  = 50% daily rotation + 50% 4h EMA trend (default, paper only)
# legacy = the original 15m trend / breakout checklist
STRATEGY_MODE=blend
# The paper runner refuses to start if this is false. Live orders are disabled.
PAPER_TRADING=true

# ── Capital and the reported goal ─────────────────────────────────────────────
CAPITAL_USDT=1000
GOAL_EQUITY_USDT=2000
MAX_POSITION_PCT=0.20
MAX_OPEN_POSITIONS=3

# ── Risk controls ─────────────────────────────────────────────────────────────
# Halt (and stay halted) when equity is 25% below the stage starting bankroll.
MAX_DRAWDOWN_PCT=0.25
# No new entries after a 3% loss versus the start of the UTC day.
DAILY_LOSS_LIMIT_PCT=0.03
# No new entries after this many consecutive losing round-trips, until reset.
MAX_CONSECUTIVE_LOSSES=6

# ── Paper trading simulation ──────────────────────────────────────────────────
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_PCT=0.0005

# ── Signal thresholds ─────────────────────────────────────────────────────────
ENTER_THRESHOLD=0.65
MONITOR_THRESHOLD=0.40

# ── Exit thresholds ───────────────────────────────────────────────────────────
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
EXIT_SCORE_THRESHOLD=0.30

# ── Runner ────────────────────────────────────────────────────────────────────
# How often the bot checks for a new closed candle (seconds).
RUN_INTERVAL_SECONDS=60
# Candles requested per symbol. Indicators need the long history.
KLINE_LIMIT=1000
# Create this file to halt the bot. Delete it before starting again.
STOP_FILE=data/STOP
BLEND_STATE_PATH=data/blend_state.json
JOURNAL_PATH=data/journal.jsonl
